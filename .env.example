# Claude API（--offline 與 --mock 模式不需要）
ANTHROPIC_API_KEY=sk-ant-...

# Ollama 離線模式（--offline）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── 翻譯後端（--deepl / --prefetch-cefr-zh）────────────────────────────────────
# 選擇翻譯後端：deepl（預設）| google | azure | claude
# 未設定時預設使用 deepl
TRANSLATE_PROVIDER=deepl

# DeepL（TRANSLATE_PROVIDER=deepl）
# 申請免費金鑰：https://www.deepl.com/pro-api（Free 方案每月 500,000 字元）
DEEPL_API_KEY=your-deepl-api-key

# Google Translate（TRANSLATE_PROVIDER=google）
# 申請：https://console.cloud.google.com/apis/library/translate.googleapis.com
# 免費：$200/月 credit（約 333 萬字元）
GOOGLE_TRANSLATE_API_KEY=your-google-api-key

# Azure Translator（TRANSLATE_PROVIDER=azure）
# 申請：https://portal.azure.com > Translator > 建立資源（F0 免費層：2,000,000 字元/月）
AZURE_TRANSLATOR_KEY=your-azure-key
AZURE_TRANSLATOR_REGION=eastasia   # 可省略，預設 eastasia

# Claude Haiku（TRANSLATE_PROVIDER=claude）
# 使用上方 ANTHROPIC_API_KEY，無需額外設定
# 適合已有 Claude API 額度、不想另申請翻譯服務的情境

# ── Merriam-Webster 英文定義（--mw / --prefetch-cefr）─────────────────────────
# 設定後 --mw / --deepl 翻譯時優先使用 MW Learner's 取得英文定義，品質優於免費字典 API
# 申請免費金鑰（1,000 req/day）：https://dictionaryapi.com/register/index
# 注意：申請時選擇 "Merriam-Webster's Learner's Dictionary"，不是 Collegiate
MW_API_KEY=your-mw-api-key

# ── 個人單字庫路徑（選用）────────────────────────────────────────────────────
# word-dict.json（使用者精選）與 word-cache.json（MW 自動快取）的儲存目錄
# 未設定時預設為 ~/.novel2anki/
# WORD_CACHE_PATH=/path/to/your/cache/dir
